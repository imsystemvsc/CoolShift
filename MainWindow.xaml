<Window x:Class="CoolShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:monitoring="clr-namespace:CoolShift.Monitoring"
        xmlns:converters="clr-namespace:CoolShift.Converters"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="CoolShift"
        Height="740"
        Width="940"
        MinHeight="660"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <converters:PercentageToArcConverter x:Key="PercentageToArcConverter" />
        <converters:CoreNameToNumberConverter x:Key="CoreNameToNumberConverter" />
        <converters:CategoryIconConverter x:Key="CategoryIconConverter" />

        <Style x:Key="OverlayScrollBarRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="RoundedComboToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="0">
                <Path Data="M 0 0 L 5 5 L 10 0"
                      Stroke="{StaticResource MutedBrush}"
                      StrokeThickness="1.5"
                      HorizontalAlignment="Right"
                      Margin="0,0,14,0"
                      VerticalAlignment="Center"
                      StrokeEndLineCap="Round"
                      StrokeStartLineCap="Round"
                      StrokeLineJoin="Round" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource WellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <ContentPresenter Margin="12,6,32,6"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" />
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource RoundedComboToggleButton}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          Focusable="False"
                                          IsTabStop="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="220" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{StaticResource SurfaceCardBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel>
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="BackgroundBorder" Property="MinHeight" Value="34" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#383E54" />
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonBaseStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource AlwaysOnTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AlwaysOnBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AlwaysOnBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AlwaysOnHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AlwaysOnHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AlwaysOnPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AlwaysOnPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4A2E12" />
                    <Setter Property="BorderBrush" Value="#4A2E12" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleMutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource SecondaryBorderBrush}"
                                Padding="0">
                            <ContentPresenter Margin="12,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource WellBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E323A" />
                    <Setter Property="BorderBrush" Value="#1E323A" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleMutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource WellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222638" />
                    <Setter Property="BorderBrush" Value="#383E54" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleMutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="0"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,16,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding ViewModel.TaskbarProgressState}" 
                         ProgressValue="{Binding ViewModel.TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Background="{StaticResource WindowBackgroundBrush}">

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding ViewModel.TrayToolTipText, FallbackValue='CoolShift'}"
                        IconSource="{Binding ViewModel.TrayIconSource}"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Resources>
                        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1E1F27" />
                        <SolidColorBrush x:Key="MenuBorderBrush" Color="#2C2E37" />
                        <SolidColorBrush x:Key="MenuForegroundBrush" Color="#EEF0F4" />
                        <SolidColorBrush x:Key="MenuHighlightBrush" Color="#2A2D38" />

                        <Style TargetType="ContextMenu">
                            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrush}" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="MenuItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
                            <Setter Property="Padding" Value="12 8" />
                            <Setter Property="Margin" Value="4 2" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="12 0 0 0" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MenuHighlightBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#6B7280" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="Separator">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Height" Value="1" />
                            <Setter Property="Margin" Value="12 4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Separator">
                                        <Border Background="{StaticResource MenuBorderBrush}" Height="1" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>

                    <MenuItem Header="{Binding ViewModel.ModeValueText, StringFormat=Current Mode: \{0\}}" IsEnabled="False">
                        <MenuItem.Icon>
                            <Image Source="{Binding ViewModel.TrayIconSource}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Switch Mode" Command="{Binding ViewModel.ToggleModeCommand}">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8AB;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Show Dashboard" Click="ShowWindow_Click">
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Resources/Icons/main.ico" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Log" Command="{Binding ViewModel.OpenLogCommand}">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="System Tools" IsEnabled="False" Foreground="#F5A24C" FontWeight="SemiBold">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Foreground="#F5A24C" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Empty Recycle Bin" Click="EmptyRecycleBin_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Restart Explorer" Click="RestartExplorer_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Task Manager" Click="OpenTaskManager_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Power Options" Click="OpenPowerOptions_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE836;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Flush DNS Cache" Click="FlushDNS_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE774;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click">
                        <MenuItem.Icon>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="15" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border Padding="20"
                CornerRadius="6"
                Margin="16"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource CardBackgroundBrush}"
                Effect="{StaticResource CardShadow}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <TabControl>
                    <TabItem Header="Overview">
        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- LEFT COLUMN: TOP -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Card 1: Power Profile -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Power Profile" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" Margin="0,0,0,10" />
                        <ComboBox x:Name="PlanCombo" 
                                  ItemsSource="{Binding ViewModel.Plans}" 
                                  SelectedItem="{Binding ViewModel.SelectedPlan}" 
                                  DisplayMemberPath="Name"
                                  ToolTip="Select the active Windows power plan. CoolShift dynamically adjusts core parking and CPU throttling for this plan.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Card 2: Quick Actions -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" Margin="0,0,0,14" />
                        
                        <Button Command="{Binding ViewModel.ToggleModeCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12" Padding="0" Cursor="Hand" ToolTip="Manually toggle between energy-efficient Cool Idle and maximum-performance Always-On modes (Hotkey: Ctrl+Shift+P).">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CoolIdleBorder" CornerRadius="4" Padding="14,10" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M 6,0 L 6,12 M 0,6 L 12,6 M 2,2 L 10,10 M 2,10 L 10,2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Switch to Cool Idle" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CoolIdleBorder" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.CurrentMode}" Value="AlwaysOn">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ViewModel.ToggleModeCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12" Padding="0" Cursor="Hand" ToolTip="Manually toggle between energy-efficient Cool Idle and maximum-performance Always-On modes (Hotkey: Ctrl+Shift+P).">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AlwaysOnBorder" CornerRadius="4" Padding="14,10" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource AlwaysOnBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                    </Border.RenderTransform>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M 6,0 L 1,7 L 5,7 L 3,13 L 9,5 L 5,5 Z" Fill="{StaticResource AlwaysOnBrush}" Width="11" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                                        <TextBlock Text="Switch to Always-On" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="AlwaysOnBorder" Property="RenderTransform">
                                                            <Setter.Value>
                                                                 <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                         <DataTrigger Binding="{Binding ViewModel.CurrentMode}" Value="CoolIdle">
                                             <Setter Property="Visibility" Value="Visible" />
                                         </DataTrigger>
                                         <DataTrigger Binding="{Binding ViewModel.CurrentMode}" Value="Custom">
                                             <Setter Property="Visibility" Value="Visible" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Cool Idle Intensity Segmented Pill Selector -->
                        <Border Margin="0,4,0,14" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Cool Idle Preset Tier" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="4,2,0,6" />
                                
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Pill 1: Max Cool -->
                                    <Button Grid.Column="0"
                                            Command="{Binding ViewModel.SelectCoolIdleTierCommand}"
                                            CommandParameter="MaxCool"
                                            Margin="1" Padding="4,6" Cursor="Hand"
                                            ToolTip="MaxCool (85% Max CPU): Aggressive cooling &amp; power saving. Minimum CPU state 5%, delayed core unparking (~75ms), 8.1W idle at ~35°C.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Content" Value="Max (85%)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.SelectedCoolIdleTier}" Value="MaxCool">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Pill 2: Balanced -->
                                    <Button Grid.Column="1"
                                            Command="{Binding ViewModel.SelectCoolIdleTierCommand}"
                                            CommandParameter="Balanced"
                                            Margin="1" Padding="4,6" Cursor="Hand"
                                            ToolTip="Balanced (99% Max CPU): Disables CPU boost clocks for quiet, cool daily computing without power spikes.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Content" Value="Balanced (99%)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.SelectedCoolIdleTier}" Value="Balanced">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Pill 3: Responsive -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ViewModel.SelectCoolIdleTierCommand}"
                                            CommandParameter="Responsive"
                                            Margin="1" Padding="4,6" Cursor="Hand"
                                            ToolTip="Responsive (100% Max CPU): Keeps full 100% CPU frequency headroom while enabling dynamic idle clock downscaling.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Content" Value="Responsive (100%)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.SelectedCoolIdleTier}" Value="Responsive">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid ToolTip="Automatically launch CoolShift in the background when Windows boots up.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding ViewModel.StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                            <TextBlock Grid.Column="1" Text="Start with Windows (Minimized)" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
                
            <!-- LEFT COLUMN: BOTTOM (Card 2.5: Status) -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" CornerRadius="6" Padding="16" Margin="0,0,16,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Status" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" Margin="0,0,0,14" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Mode:" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ViewModel.ModeValueText}" FontFamily="Bahnschrift" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        
                        <TextBlock Text="Automation:" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ViewModel.AutomationStatusText}" FontFamily="Bahnschrift" Foreground="{StaticResource ForegroundBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" MaxWidth="280" />
                        
                        <TextBlock Text="Active Profile:" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ViewModel.SelectedPlan.Name}" FontFamily="Bahnschrift" Foreground="{StaticResource ForegroundBrush}" FontSize="12" MaxWidth="280" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            
            <!-- RIGHT COLUMN: TOP (Card 3: Thermals & Telemetry) -->
            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" CornerRadius="6" Padding="20,18" Margin="0,0,0,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="System Vitals" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" Margin="0,0,0,14" />
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- CPU Temp + Gauge -->
                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CPU Temp:" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ViewModel.PackageTempText, FallbackValue='45.0 °C'}" FontFamily="Bahnschrift" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="50" Height="50">
                                                <Ellipse Width="42" Height="42" Stroke="#222533" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Path Stroke="{Binding ViewModel.CpuLoadBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="{Binding ViewModel.CpuLoad, Converter={StaticResource PercentageToArcConverter}}" />
                                                <TextBlock Text="{Binding ViewModel.CpuLoadText, FallbackValue='42%'}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                            <TextBlock Text="LOAD" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                
                                <!-- GPU Temp + Gauge -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="GPU Temp:" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ViewModel.GpuTempText, FallbackValue='45.0 °C'}" FontFamily="Bahnschrift" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="50" Height="50">
                                                <Ellipse Width="42" Height="42" Stroke="#222533" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Path Stroke="{Binding ViewModel.GpuLoadBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="{Binding ViewModel.GpuLoad, Converter={StaticResource PercentageToArcConverter}}" />
                                                <TextBlock Text="{Binding ViewModel.GpuLoadText, FallbackValue='42%'}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                            <TextBlock Text="LOAD" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            
                            <!-- Live Hardware Sensor Telemetry Panel -->
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="Hardware Telemetry" FontFamily="Bahnschrift" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- CPU Telemetry Row -->
                                    <Border Grid.Row="0" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- CPU Wattage -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU Package Power" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.CpuPowerText, FallbackValue='24.5 W'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- CPU Clock -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CPU Clock" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.CpuClockText, FallbackValue='4.35 GHz'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- CPU Voltage -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CPU VCORE" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.CpuVoltageText, FallbackValue='1.18 V'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- GPU Telemetry Row -->
                                    <Border Grid.Row="1" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- GPU Wattage -->
                                            <StackPanel Grid.Column="0" ToolTip="Live GPU Board / Package Power consumption in Watts (W).">
                                                <TextBlock Text="GPU Power" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.GpuPowerText, FallbackValue='65.0 W'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- GPU Clock -->
                                            <StackPanel Grid.Column="1" ToolTip="Real-time GPU Core Clock speed in MHz.">
                                                <TextBlock Text="GPU Clock" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.GpuClockText, FallbackValue='2100 MHz'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- GPU Voltage / Temp -->
                                            <StackPanel Grid.Column="2" ToolTip="Live GPU Core Voltage read directly from MSI Afterburner shared memory.">
                                                <TextBlock Text="{Binding ViewModel.GpuVoltageLabel, FallbackValue='GPU VCORE'}" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding ViewModel.GpuVoltageText, FallbackValue='1.05 V'}" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                </Border>

                <!-- RIGHT COLUMN: BOTTOM (Card 4: Core Parking Status) -->
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" CornerRadius="6" Padding="20" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewModel.Cores.Count, StringFormat='Logical Processors ({0} Threads)', FallbackValue='Logical Processors'}" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="13" Margin="0,0,0,14" ToolTip="Real-time map of unparked (illuminated) vs. parked (dark slate) logical CPU cores." />
                        
                        <ItemsControl ItemsSource="{Binding ViewModel.Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="0,0,-6,0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Margin="0,0,6,6" ToolTip="{Binding CoreName}" Width="44" Height="44" BorderThickness="1.5">
                                        <TextBlock Text="{Binding CoreName, Converter={StaticResource CoreNameToNumberConverter}}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   FontFamily="Bahnschrift" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource ActiveCoreBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ActiveCoreBorderBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource ActiveCoreTextBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00B4D8" BlurRadius="6" Opacity="0.25" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsParked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ParkedCoreBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ParkedCoreBorderBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource ParkedCoreTextBrush}" />
                                                        <Setter Property="Effect" Value="{x:Null}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.ViewModel.CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="AlwaysOn">
                                                        <Setter Property="Background" Value="#2A1E0D" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AlwaysOnBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="#FBBF24" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#F59E0B" BlurRadius="6" Opacity="0.25" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsParked}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.ViewModel.CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="AlwaysOn" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource ParkedCoreBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ParkedCoreBorderBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource ParkedCoreTextBrush}" />
                                                        <Setter Property="Effect" Value="{x:Null}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
        </Grid>
</TabItem>
<TabItem Header="Monitoring">
                        <Border Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0 0 0 16"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Sensors"
                                               FontFamily="Bahnschrift"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="15" />
                                    <Button Grid.Column="1"
                                            Content="Settings"
                                            Margin="12 0 0 0"
                                            Padding="18 6"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenMonitoringSettings_Click" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0 16 0 0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <ListView x:Name="ActiveSensorsList"
                                                  ItemsSource="{Binding MonitoringSensorsView}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="{StaticResource ForegroundBrush}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="0"
                                                  AllowDrop="True"
                                                  PreviewMouseWheel="ActiveSensorsList_PreviewMouseWheel"
                                                  PreviewMouseLeftButtonDown="ActiveSensorsList_PreviewMouseLeftButtonDown"
                                                  MouseMove="ActiveSensorsList_MouseMove"
                                                  DragOver="ActiveSensorsList_DragOver"
                                                  Drop="ActiveSensorsList_Drop"
                                                  ItemContainerStyle="{StaticResource ListRowItemStyle}">
                                            <ListView.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                                            </ListView.Resources>
                                            <ListView.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.Panel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </GroupStyle.Panel>
                                                    <GroupStyle.ContainerStyle>
                                                        <Style TargetType="GroupItem">
                                                            <Setter Property="Margin" Value="0,0,10,10" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="GroupItem">
                                                                        <Border Background="{StaticResource WellBackgroundBrush}"
                                                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="12,10">
                                                                            <StackPanel>
                                                                                <!-- Category Card Header -->
                                                                                <Grid Margin="0,0,0,8">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                                                                            <TextBlock Text="{Binding Name, Converter={StaticResource CategoryIconConverter}}" FontSize="12" VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   FontFamily="Bahnschrift"
                                                                                                   Foreground="{StaticResource ForegroundBrush}"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding ItemCount, StringFormat='{}{0} Sensors'}"
                                                                                               FontFamily="Bahnschrift"
                                                                                               Foreground="{StaticResource MutedBrush}"
                                                                                               FontSize="11"
                                                                                               VerticalAlignment="Center" />
                                                                                </Grid>
                                                                                <Border Height="1" Background="{StaticResource SecondaryBorderBrush}" Margin="0,0,0,6" />

                                                                                <!-- Card Sensors -->
                                                                                <ItemsPresenter />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </GroupStyle.ContainerStyle>
                                                </GroupStyle>
                                            </ListView.GroupStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource SecondaryBorderBrush}" Padding="2,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="85" />
                                                                <ColumnDefinition Width="105" />
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Sensor Name with Icon -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SensorIcon}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding SensorDisplayName}"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           FontSize="12.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Mini Progress Bar -->
                                                            <ProgressBar Grid.Column="1"
                                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="4"
                                                                         Margin="4,0,8,0"
                                                                         VerticalAlignment="Center"
                                                                         Background="{StaticResource SurfaceCardBrush}"
                                                                         Foreground="{StaticResource AccentBrush}"
                                                                         BorderThickness="0">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasProgress}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>

                                                            <!-- Current Display Value -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding CurrentDisplay}"
                                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ForegroundBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Min / Max Range -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MinDisplay}" Foreground="{StaticResource SubtleMutedBrush}" FontSize="10.5" FontFamily="Consolas" />
                                                                <TextBlock Text=" / " Foreground="{StaticResource SubtleMutedBrush}" FontSize="10.5" FontFamily="Consolas" />
                                                                <TextBlock Text="{Binding MaxDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontFamily="Consolas" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <TextBlock Text="No sensors selected. Open Settings to choose sensors."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MonitoringSensorsView.IsEmpty}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                     </Grid>
                                 </Grid>
                             </Grid>
                         </Border>
                    </TabItem>
                    
                    <TabItem Header="Automation">
                        <Border Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0 0 0 16"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Smart Battery Toggle -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <TextBlock Text="Smart Battery Detection" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="15" Margin="0,0,0,4" />
                                    <TextBlock Text="Automatically forces 'Cool Idle' when unplugged, overriding selected apps." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <CheckBox Content="Enable Smart Battery Override" IsChecked="{Binding ViewModel.SmartBatteryEnabled}" Foreground="{StaticResource ForegroundBrush}" ToolTip="Automatically enforce Cool Idle mode when running on battery power to conserve battery life." />
                                </StackPanel>

                                <!-- Game Auto-Switching -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Game Auto-Switching" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" FontSize="15" Margin="0,0,0,4" />
                                        <TextBlock Text="Forces 'Always-On' when manually selected apps are running." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Pick Running..." Command="{Binding ViewModel.AddRunningGameCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Select from currently running background applications and games." />
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding ViewModel.AddGameExecutableCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" VerticalAlignment="Center" ToolTip="Manually select an executable file (.exe) from your file system." />
                                </Grid>

                                <!-- Configured Games List -->
                                <Border Grid.Row="2" Background="{StaticResource WellBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <ListView ItemsSource="{Binding ViewModel.TargetExecutableViewModels}" 
                                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}"
                                              ItemContainerStyle="{StaticResource ListRowItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource ForegroundBrush}" FontSize="14" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" 
                                                            Content="✕" 
                                                            Command="{Binding DataContext.ViewModel.RemoveGameExecutableCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Padding="8,0"
                                                            ToolTip="Remove Game" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                  </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                
                                                        </TabControl>

            </Grid>

        </Border>

    </Grid>

</Window>






